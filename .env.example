# Supabase (Painel do projeto → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo do cron (Vercel injeta este Bearer nos crons automaticamente).
# Usado por /api/financeiro/materializar e /api/wa/diario.
CRON_SECRET=

# Sentinela (edge function que lê o Meta Ads via App próprio + token de
# System User em tokens_meta). Usado pelo botão "Atualizar dados" e pelo
# cron sentinela_9h (ver supabase/migrations/20260720_sentinela_cron_9h.sql).
# Mesmo valor configurado no header x-sentinela-secret do cron no Supabase.
SENTINELA_SECRET=

# Secret do endpoint interno /api/sentinela/notificar (chamado pelo cron
# sentinela_9h_notificar alguns minutos depois de sentinela_9h, pra criar a
# notificação "Tráfego atualizado" no sino). Gere um valor aleatório
# qualquer — mesmo padrão de INTERNAL_PUSH_SECRET.
SENTINELA_NOTIFY_SECRET=

# [DESCONTINUADO 2026-07-20] Ponte MCP — usada enquanto o App do Meta estava
# deletado. Recriamos o App (ver memória meta-app-setup-gotchas) e voltamos
# a usar SENTINELA_SECRET acima; a rotina claude.ai foi excluída. Mantido
# comentado só pra referência/recuperação futura.
# ROUTINE_FIRE_TOKEN=
# ROUTINE_FIRE_ID=

# WhatsApp Cloud API (Meta) - envio dos relatorios diarios.
# Painel: developers.facebook.com -> seu App -> WhatsApp -> API Setup.
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=

# CRM — Evolution API (WhatsApp via QR, multi-numero). NAMESPACE separado do
# Meta acima: os dois coexistem e NAO se cruzam. O webhook do CRM valida o
# EVOLUTION_WEBHOOK_SECRET no PATH da URL
# (POST /api/crm/wa/webhook/<EVOLUTION_WEBHOOK_SECRET>).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Asana — importação/migração para o Workspace (SOMENTE LEITURA).
# Personal Access Token: https://app.asana.com/0/my-apps -> Create new token.
# Usado só por scripts/asana-import.ts, no servidor. Nunca vai pro browser.
# Sem ele o importador ainda roda em modo --arquivo (replay de snapshot JSON).
ASANA_PAT=
