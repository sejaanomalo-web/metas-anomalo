# Supabase (Painel do projeto → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo do cron (Vercel injeta este Bearer nos crons automaticamente).
# Usado por /api/financeiro/materializar e /api/wa/diario.
CRON_SECRET=

# Segredo do agente Sentinela (edge function). É o MESMO valor usado pelo
# cron do Sentinela. Necessário para o botão "Atualizar dados" do dashboard
# de Tráfego disparar uma execução sob demanda (header x-sentinela-secret).
SENTINELA_SECRET=
# Opcional: sobrescreve a URL da edge function. Por padrão usa
# ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/sentinela
# SENTINELA_URL=

# WhatsApp Cloud API (Meta) - envio dos relatorios diarios.
# Painel: developers.facebook.com -> seu App -> WhatsApp -> API Setup.
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
