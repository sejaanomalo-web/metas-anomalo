# Supabase (Painel do projeto → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo do cron (Vercel injeta este Bearer nos crons automaticamente).
# Usado por /api/financeiro/materializar e /api/wa/diario.
CRON_SECRET=

# [DESCONTINUADO] Sentinela legada (edge function que lia o App do Meta). O
# App foi apagado e a coleta migrou pra ponte MCP — o app NÃO usa mais estas
# variáveis. Mantidas comentadas só pra referência/recuperação futura.
# SENTINELA_SECRET=
# SENTINELA_URL=

# Ponte MCP — o botão "Atualizar dados" dispara a rotina de coleta no
# claude.ai. Gere o token na rotina (claude.ai/code/routines → Editar →
# Add trigger → API → Generate token). ROUTINE_FIRE_ID é opcional (default
# no código: trig_01M6HhPedJDKwr684uEwYBfz).
ROUTINE_FIRE_TOKEN=
# ROUTINE_FIRE_ID=

# WhatsApp Cloud API (Meta) - envio dos relatorios diarios.
# Painel: developers.facebook.com -> seu App -> WhatsApp -> API Setup.
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=

# CRM — Evolution API (WhatsApp via QR, multi-numero). NAMESPACE separado do
# Meta acima: os dois coexistem e NAO se cruzam. O webhook do CRM valida o
# EVOLUTION_WEBHOOK_SECRET no PATH da URL
# (POST /api/crm/wa/webhook/<EVOLUTION_WEBHOOK_SECRET>).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
